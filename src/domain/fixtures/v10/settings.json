{
  "schemaVersion": 10,
  "libraryDir": "${OneDrive}/Pinout/lib",
  "palette": [
    {
      "name": "Noir",
      "hex": "#000000"
    },
    {
      "name": "Rouge",
      "hex": "#d62828"
    },
    {
      "name": "#FF00AA",
      "hex": "#ff00aa"
    }
  ],
  "defaultWireColor": "#000000",
  "defaultProfile": {
    "name": "Standard",
    "cellPx": 20,
    "wireWidth": 0.15,
    "cornerRadius": 0.4,
    "componentStroke": 0.1,
    "junctionScale": 2,
    "junctionColor": "wire",
    "labelFont": {
      "family": "Segoe UI",
      "size": 11
    },
    "endLabelFont": {
      "family": "Segoe UI",
      "size": 14
    }
  },
  "diagramDefaults": {
    "style": {
      "cellPx": 10,
      "lineWidth": 0.2,
      "cornerRadius": 0.8,
      "nodeRadius": 1,
      "font": "mono",
      "titleSize": 14,
      "subtitleSize": 12,
      "labelSize": 12
    },
    "nodeColor": "#1d4ed8",
    "nodeFill": "none",
    "linkColor": "#000000"
  },
  "recentFiles": [],
  "export": {
    "scale": 2,
    "background": "white",
    "marginCells": 2,
    "labels": true,
    "grid": false
  },
  "autosaveSeconds": 120,
  "theme": "light",
  "autoOpenInspector": true,
  "libraryView": "grid"
}
